[gd_resource type="Resource" script_class="NarrativeEventDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/models/narrative_event_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"event_leilao_ferrugem"
arc_id = &"arc_o_sistema"
dialogue_key = &"dialogue_event_leilao_ferrugem"
unlock_after_arc_id = &"arc_dois_mercados"
required_flags = PackedStringArray("lore_isa_process_introduction_seen", "lore_farol_tape_four_marks_heard")
participants = PackedStringArray("char_rui", "char_lucia", "char_helena", "char_joana")
choice_ids = PackedStringArray("choice_ferrugem_aurora_custody", "choice_ferrugem_shared_custody", "choice_ferrugem_document_without_ownership")
choice_flags = {
"choice_ferrugem_aurora_custody": PackedStringArray("lore_ferrugem_lot_seen", "choice_ferrugem_aurora_custody"),
"choice_ferrugem_shared_custody": PackedStringArray("lore_ferrugem_lot_seen", "choice_ferrugem_shared_custody"),
"choice_ferrugem_document_without_ownership": PackedStringArray("lore_ferrugem_lot_seen", "choice_ferrugem_document_without_ownership")
}
relationship_effects = {
"choice_ferrugem_aurora_custody": PackedStringArray("char_lucia_trust_up", "char_rui_access_concern_up"),
"choice_ferrugem_shared_custody": PackedStringArray("char_rui_trust_up", "char_joana_trust_up", "char_lucia_method_guard_up"),
"choice_ferrugem_document_without_ownership": PackedStringArray("char_rui_trust_up", "char_lucia_material_loss_concern_up")
}
system_signals = {
"choice_ferrugem_aurora_custody": PackedStringArray("signal_research_up", "signal_legitimacy_up", "signal_access_down"),
"choice_ferrugem_shared_custody": PackedStringArray("signal_memory_up", "signal_community_up", "signal_complexity_up"),
"choice_ferrugem_document_without_ownership": PackedStringArray("signal_cash_neutral", "signal_memory_up", "signal_research_down")
}
lore_assertions = PackedStringArray("lore_ferrugem_lot_seen")
canon_guardrails = PackedStringArray("ferrugem_lot_is_mixed_evidence", "old_material_does_not_authenticate_lineage_or_authorship", "recent_items_are_not_automatically_fraud", "auction_remains_abstract_non_operational")
display_title = "O Lote Ferrugem"
body_text = "Um lote atribuído ao núcleo perdido do Caderno mistura materiais compatíveis com acervo antigo, cópias recentes e peças impossíveis de datar com segurança. Preservar não pode transformar raridade em autenticidade."
choice_labels = {
"choice_ferrugem_aurora_custody": "Apoiar custódia do Aurora com procedência explícita",
"choice_ferrugem_shared_custody": "Apoiar custódia compartilhada",
"choice_ferrugem_document_without_ownership": "Preservar registro sem disputar a posse"
}
