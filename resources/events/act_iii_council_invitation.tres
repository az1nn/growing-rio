[gd_resource type="Resource" script_class="NarrativeEventDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/models/narrative_event_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"event_act_iii_council_invitation"
arc_id = &"arc_dois_mercados"
dialogue_key = &"dialogue_event_act_iii_council_invitation"
unlock_after_arc_id = &"arc_o_negocio"
required_flags = PackedStringArray("lore_farol_tape_four_marks_heard", "lore_farol_tape_date_unverified", "campaign_business_scale_reached")
participants = PackedStringArray("char_caio")
choice_ids = PackedStringArray("choice_council_receive_invitation")
choice_flags = {
"choice_council_receive_invitation": PackedStringArray("lore_council_invitation_received", "choice_council_receive_invitation")
}
relationship_effects = {
"choice_council_receive_invitation": PackedStringArray("char_caio_process_trust_up")
}
system_signals = {
"choice_council_receive_invitation": PackedStringArray("signal_influence_up", "signal_formal_stability_up")
}
lore_assertions = PackedStringArray("lore_council_invitation_received")
canon_guardrails = PackedStringArray("council_invitation_requires_no_correct_market_route", "institutional_progression_is_fictional", "influence_is_access_not_control")
display_title = "O convite"
body_text = "Com escala suficiente para ser ouvido e a investigação já maior que uma única peça, chega o convite para participar do Conselho Cívico da Baía. O convite abre processo; não concede controle sobre ele."
choice_labels = {
"choice_council_receive_invitation": "Receber o convite e seguir para o Conselho"
}
