[gd_resource type="Resource" script_class="NarrativeEventDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/models/narrative_event_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"event_bento_fita_farol"
