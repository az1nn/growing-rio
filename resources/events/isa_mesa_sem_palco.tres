[gd_resource type="Resource" script_class="NarrativeEventDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/models/narrative_event_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"event_isa_mesa_sem_palco"
arc_id = &"arc_o_sistema"
dialogue_key = &"dialogue_event_isa_mesa_sem_palco"
unlock_after_arc_id = &"arc_dois_mercados"
required_flags = PackedStringArray("lore_council_invitation_received")
participants = PackedStringArray("char_isa", "char_caio")
choice_ids = PackedStringArray("choice_isa_disclose_tradeoffs", "choice_isa_predictability_first", "choice_isa_access_first")
choice_flags = {
"choice_isa_disclose_tradeoffs": PackedStringArray("lore_isa_process_introduction_seen", "choice_isa_disclose_tradeoffs"),
"choice_isa_predictability_first": PackedStringArray("lore_isa_process_introduction_seen", "choice_isa_predictability_first"),
"choice_isa_access_first": PackedStringArray("lore_isa_process_introduction_seen", "choice_isa_access_first")
}
relationship_effects = {
"choice_isa_disclose_tradeoffs": PackedStringArray("char_isa_process_trust_up", "char_caio_legibility_up"),
"choice_isa_predictability_first": PackedStringArray("char_isa_position_recorded", "char_joana_cost_question_up"),
"choice_isa_access_first": PackedStringArray("char_joana_trust_up", "char_isa_process_complexity_up")
}
system_signals = {
"choice_isa_disclose_tradeoffs": PackedStringArray("signal_legitimacy_up", "signal_influence_up", "signal_flexibility_down"),
"choice_isa_predictability_first": PackedStringArray("signal_formal_stability_up", "signal_scale_up", "signal_community_neutral"),
"choice_isa_access_first": PackedStringArray("signal_community_up", "signal_influence_up", "signal_delay_up")
}
lore_assertions = PackedStringArray("lore_isa_process_introduction_seen")
canon_guardrails = PackedStringArray("isa_is_process_mediator_not_moral_arbiter", "council_entry_is_route_neutral", "influence_is_access_not_control")
display_title = "A Mesa Não É Palco"
body_text = "Isa explica que o Conselho existe para tornar trade-offs legíveis antes de virarem regra. Ela não pede concordância: pede que cada posição deixe custos e contradições registráveis."
choice_labels = {
"choice_isa_disclose_tradeoffs": "Declarar interesses e contradições",
"choice_isa_predictability_first": "Defender previsibilidade econômica",
"choice_isa_access_first": "Ampliar vozes com menos acesso"
}
