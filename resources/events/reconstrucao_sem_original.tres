choice_flags = {
"choice_reconstruction_public_uncertainty": PackedStringArray("lore_act_v_reconstruction_framed", "choice_reconstruction_public_uncertainty"),
"choice_reconstruction_layered_disclosure": PackedStringArray("lore_act_v_reconstruction_framed", "choice_reconstruction_layered_disclosure"),
"choice_reconstruction_research_first": PackedStringArray("lore_act_v_reconstruction_framed", "choice_reconstruction_research_first")
}
relationship_effects = {
"choice_reconstruction_public_uncertainty": PackedStringArray("char_lucia_trust_up", "char_rui_public_uncertainty_up", "char_helena_marketing_friction_up"),
"choice_reconstruction_layered_disclosure": PackedStringArray("char_maya_legibility_up", "char_lucia_summary_guard_up", "char_rui_memory_tension_up"),
"choice_reconstruction_research_first": PackedStringArray("char_lucia_caution_up", "char_joana_access_question_up", "char_helena_scale_delay_up")
}
system_signals = {
