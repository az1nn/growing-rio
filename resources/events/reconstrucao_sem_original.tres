"choice_reconstruction_layered_disclosure": PackedStringArray("signal_market_access_up", "signal_research_preserved", "signal_memory_tension_up"),
"choice_reconstruction_research_first": PackedStringArray("signal_research_up", "signal_scale_delay_up", "signal_governance_pressure_up")
