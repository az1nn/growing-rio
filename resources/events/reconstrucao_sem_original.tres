lore_assertions = PackedStringArray("lore_act_v_reconstruction_framed")
canon_guardrails = PackedStringArray("reconstruction_is_contemporary", "material_compatibility_does_not_prove_lineage", "caderno_authorship_remains_open", "farol_date_voice_remain_open", "symbol_order_remains_open", "onda_can_provenance_remains_open")
display_title = "Não Existe Original para Voltar"
body_text = "Lúcia encerra a revisão: há conexões materiais e memória suficiente para reconstruir no presente, mas não prova de uma linhagem botânica contínua. DA LATA só pode avançar declarando as lacunas em vez de transformá-las em certeza."
choice_labels = {
"choice_reconstruction_public_uncertainty": "Tornar a incerteza parte pública do projeto",
"choice_reconstruction_layered_disclosure": "Separar resumo público e dossiê completo sem esconder a conclusão",
"choice_reconstruction_research_first": "Manter a reconstrução primeiro como projeto de pesquisa"
}
