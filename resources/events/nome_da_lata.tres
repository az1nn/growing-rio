[gd_resource type="Resource" script_class="NarrativeEventDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/models/narrative_event_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"event_nome_da_lata"
arc_id = &"arc_da_lata"
dialogue_key = &"dialogue_event_nome_da_lata"
unlock_after_arc_id = &"arc_o_sistema"
required_flags = PackedStringArray("lore_act_v_city_contributions_mapped")
participants = PackedStringArray("char_dalva", "char_lucia", "char_rui", "char_joana")
choice_ids = PackedStringArray("choice_name_memory_forward", "choice_name_evidence_forward", "choice_name_governance_forward")
choice_flags = {
"choice_name_memory_forward": PackedStringArray("lore_da_lata_name_canonical", "choice_name_memory_forward"),
"choice_name_evidence_forward": PackedStringArray("lore_da_lata_name_canonical", "choice_name_evidence_forward"),
"choice_name_governance_forward": PackedStringArray("lore_da_lata_name_canonical", "choice_name_governance_forward")
}
relationship_effects = {
"choice_name_memory_forward": PackedStringArray("char_rui_trust_up", "char_joana_memory_credit_up"),
"choice_name_evidence_forward": PackedStringArray("char_lucia_trust_up", "char_rui_memory_priority_tension_up"),
"choice_name_governance_forward": PackedStringArray("char_joana_governance_trust_up", "char_helena_scale_question_up")
}
system_signals = {
"choice_name_memory_forward": PackedStringArray("signal_memory_up", "signal_public_context_up"),
"choice_name_evidence_forward": PackedStringArray("signal_research_up", "signal_legitimacy_up"),
"choice_name_governance_forward": PackedStringArray("signal_governance_pressure_up", "signal_identity_up")
}
lore_assertions = PackedStringArray("lore_da_lata_name_canonical")
canon_guardrails = PackedStringArray("name_is_present_decision_not_historical_authentication", "dalva_does_not_authenticate_origin", "onda_can_provenance_remains_open", "symbol_order_remains_open", "continuous_lineage_remains_unproven")
display_title = "O Nome que Já Estava Lá"
body_text = "Depois de ciência, memória, mercado e comunidade disputarem precisão e pertencimento, Dalva corta a tensão: 'Chama de DA LATA e para de frescura.' O nome vira decisão presente, não revelação histórica."
choice_labels = {
"choice_name_memory_forward": "DA LATA — com a história fragmentada junto",
"choice_name_evidence_forward": "DA LATA — sem chamar reconstrução de original",
"choice_name_governance_forward": "DA LATA — e agora decidir quem pode falar pelo nome"
}
