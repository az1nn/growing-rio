[gd_resource type="Resource" script_class="EndingPresentationDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/models/ending_presentation_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"ending_rede_viva"
display_name = "Rede Viva"
handoff_text = "DA LATA entra no último handoff como uma reconstrução contemporânea de memória fragmentada. O arranjo escolhido distribui o projeto por uma rede cooperativa, sem declarar superioridade sobre outros desfechos elegíveis."
coda_text = "DA LATA deixa de ser um produto único e passa a circular como selo cultural entre pequenos operadores sob regras comuns. A última cena retorna ao Morro do Cedro."
canon_guardrails = PackedStringArray("no_ending_is_morally_ranked", "continuous_lineage_remains_unproven")
