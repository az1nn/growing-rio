[gd_resource type="Resource" script_class="EndingPresentationDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/models/ending_presentation_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"ending_o_verao_volta"
display_name = "O Verão Volta"
handoff_text = "DA LATA entra no último handoff sem reivindicar continuidade histórica ou genética. Este é um final composto, não um final verdadeiro: pesquisa, comunidade, reputação, Influence e participação nos dois mercados convergem sem apagar suas tensões."
coda_text = "Depois do lançamento com a origem fragmentária publicada, uma tempestade atravessa a cidade. Na manhã seguinte, uma criança encontra uma lata vazia na areia. Dentro dela: Onda. Sol. Ferrugem. Estrela. Corta para preto."
canon_guardrails = PackedStringArray("no_ending_is_morally_ranked", "o_verao_volta_is_composite_not_true_ending", "continuous_lineage_remains_unproven")
