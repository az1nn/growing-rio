[gd_resource type="Resource" script_class="EndingPresentationDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/models/ending_presentation_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"ending_noite_sem_rotulo"
display_name = "Noite Sem Rótulo"
handoff_text = "DA LATA entra no último handoff sem reivindicar pureza histórica. A estrutura escolhida preserva autonomia e uma rede paralela abstrata; o jogo registra custos e trade-offs sem recomendar essa forma."
coda_text = "DA LATA vira uma lenda contemporânea que aparece e desaparece do mercado. A marca não é formalizada, e Heat continua fazendo parte do preço dessa escolha."
canon_guardrails = PackedStringArray("no_ending_is_morally_ranked", "continuous_lineage_remains_unproven", "parallel_market_remains_abstract")
