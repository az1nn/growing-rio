[gd_resource type="Resource" script_class="ResearchStepDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/models/research_step_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"research_material_compatibility_review"
display_name = "Revisar a compatibilidade material do Ato IV"
required_flags = PackedStringArray("research_evidence_boundaries_synthesized", "lore_material_origin_compatibility_established", "lore_star_mark_revealed", "lore_original_lineage_still_unproven", "lore_dalva_lucia_symbol_order_disputed")
forbidden_flags = PackedStringArray("lore_dalva_lucia_symbol_order_resolved")
completion_flags = PackedStringArray("research_material_compatibility_reviewed")
evidence_tags = PackedStringArray("evidence_material_compatibility_limited", "evidence_provenance_unresolved", "evidence_symbol_order_disputed", "evidence_chain_of_custody_gaps")
system_signals = PackedStringArray("signal_research_up", "signal_memory_up")
canon_guardrails = PackedStringArray("material_compatibility_does_not_prove_lineage", "onda_can_provenance_remains_open", "symbol_order_remains_open", "research_does_not_authenticate_historical_lineage", "research_records_uncertainty")
