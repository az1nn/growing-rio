{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growing-rio",
  "main": "src/cloudflare-worker.js",
  "compatibility_date": "2026-10-05",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/index.wasm"
    ]
  }
}
