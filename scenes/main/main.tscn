[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("4_theme")
script = ExtResource("1_main")


[node name="ContextualSceneHost" parent="." instance=ExtResource("2_diorama_host")]

[node name="AtmosphereVeil" type="ColorRect" parent="."]
layout_mode = 1
