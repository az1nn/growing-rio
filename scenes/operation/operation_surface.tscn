[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/operation/operation_surface.gd" id="1_operation"]

[node name="OperationSurface" type="Control"]
custom_minimum_size = Vector2(0, 360)
layout_mode = 2
script = ExtResource("1_operation")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="Heading" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="VBox/Heading"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 30
text = "Operação"

[node name="ActiveRoomLabel" type="Label" parent="VBox/Heading"]
unique_name_in_owner = true
layout_mode = 2
text = "Sala ativa: room_1"
horizontal_alignment = 2

[node name="CycleLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Ciclo: dia 0 / 30"

[node name="HealthLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Saúde do lote: 72%"

[node name="ProgressBar" type="ProgressBar" parent="VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
value = 0.0
show_percentage = true

[node name="InventoryLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Estoque local: 0"

[node name="AvailabilityLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "A disponibilidade das ações vem do domínio."
autowrap_mode = 2

[node name="GrowActions" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="CareButton" type="Button" parent="VBox/GrowActions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 58)
layout_mode = 2
size_flags_horizontal = 3
text = "Cuidar (-R$5)"

[node name="NextDayButton" type="Button" parent="VBox/GrowActions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 58)
layout_mode = 2
size_flags_horizontal = 3
text = "Avançar dia"

[node name="HarvestButton" type="Button" parent="VBox/GrowActions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 58)
layout_mode = 2
size_flags_horizontal = 3
text = "Colher"

[node name="ManagementHandoff" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ManagementCopy" type="Label" parent="VBox/ManagementHandoff"]
layout_mode = 2
size_flags_horizontal = 3
text = "Salas, equipe e melhorias"
autowrap_mode = 2

[node name="ManagementButton" type="Button" parent="VBox/ManagementHandoff"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 58)
layout_mode = 2
text = "Abrir gestão"

[node name="FeedbackPanel" type="PanelContainer" parent="VBox"]
custom_minimum_size = Vector2(0, 84)
layout_mode = 2

[node name="FeedbackLabel" type="Label" parent="VBox/FeedbackPanel"]
unique_name_in_owner = true
layout_mode = 2
text = "Feedback local da operação."
autowrap_mode = 2
vertical_alignment = 1
horizontal_alignment = 1

[connection signal="pressed" from="VBox/GrowActions/CareButton" to="." method="_on_care_pressed"]
[connection signal="pressed" from="VBox/GrowActions/NextDayButton" to="." method="_on_next_day_pressed"]
[connection signal="pressed" from="VBox/GrowActions/HarvestButton" to="." method="_on_harvest_pressed"]

[connection signal="pressed" from="VBox/ManagementHandoff/ManagementButton" to="." method="_on_management_pressed"]
