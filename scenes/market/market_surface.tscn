[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scenes/market/market_surface.gd" id="1_market"]
[ext_resource type="PackedScene" path="res://scenes/visual/market_diorama.tscn" id="2_interactive_3d"]
[ext_resource type="Script" path="res://scenes/ui/v1/dalata_button.gd" id="3_ui_button"]
[ext_resource type="Theme" path="res://resources/ui/v1/dalata_ui_theme.tres" id="4_ui_theme"]

[node name="MarketSurface" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("4_ui_theme")
script = ExtResource("1_market")

[node name="Interactive3D" parent="." instance=ExtResource("2_interactive_3d")]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
[node name="ActionDeck" type="Panel" parent="."]
z_index = 29
layout_mode = 1
anchor_top = 0.74
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Accent" type="ColorRect" parent="ActionDeck"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 6.0
grow_horizontal = 2
mouse_filter = 2
color = Color(0.95, 0.61, 0.17, 1)

[node name="Tag" type="Label" parent="ActionDeck"]
layout_mode = 0
offset_left = 14.0
offset_top = 10.0
offset_right = 360.0
offset_bottom = 38.0
mouse_filter = 2
theme_override_colors/font_color = Color(0.94, 0.92, 0.84, 1)
theme_override_font_sizes/font_size = 18
text = "MERCADO / AÇÕES"

[node name="Scroll" type="ScrollContainer" parent="."]
z_index = 30
layout_mode = 1
anchor_top = 0.74
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0

[node name="Margin" type="MarginContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 18

[node name="VBox" type="VBoxContainer" parent="Scroll/Margin"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Scroll/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "Mercado"

[node name="Help" type="Label" parent="Scroll/Margin/VBox"]
layout_mode = 2
text = "Escolha canal, contrato ou rota. Risco e retorno aparecem como efeitos sistêmicos."
autowrap_mode = 2

[node name="MarketSummaryLabel" type="Label" parent="Scroll/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Estoque: 0 un. • Qualidade: Comum"

[node name="MarketContextLabel" type="Label" parent="Scroll/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Demanda distrital: 0 • Multiplicador: x1.00 • Compliance: nível 0"
autowrap_mode = 2

[node name="CityDetailButton" type="Button" parent="Scroll/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
text = "CIDADE · DETALHES"
script = ExtResource("3_ui_button")
role = 1
semantic_action_id = &"market/city_details"

[node name="Separator" type="HSeparator" parent="Scroll/Margin/VBox"]
layout_mode = 2

[node name="BuyerList" type="VBoxContainer" parent="Scroll/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="MarketFeedbackLabel" type="Label" parent="Scroll/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
text = "Selecione uma ação de mercado."
autowrap_mode = 2
horizontal_alignment = 1

[connection signal="pressed" from="Scroll/Margin/VBox/CityDetailButton" to="." method="_on_city_pressed"]
