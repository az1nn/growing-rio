anchor_left = 0.67
anchor_top = 0.49
anchor_right = 0.96
anchor_bottom = 0.55
grow_horizontal = 2
grow_vertical = 2
text = "Distritos"
script = ExtResource("2_ui_button")
role = 2
semantic_action_id = &"city/hotspot/districts"

[connection signal="input_event" from="ViewportContainer/Viewport/World/DistrictOverlookInteraction" to="." method="_on_district_overlook_input_event"]
[connection signal="input_event" from="ViewportContainer/Viewport/World/CommunityClusterInteraction" to="." method="_on_community_cluster_input_event"]
[connection signal="input_event" from="ViewportContainer/Viewport/World/RouteNodesInteraction" to="." method="_on_route_nodes_input_event"]
[connection signal="pressed" from="CommunityActionButton" to="." method="_on_community_action_button_pressed"]
[connection signal="pressed" from="RouteActionButton" to="." method="_on_route_action_button_pressed"]
[connection signal="pressed" from="ObjectActionButton" to="." method="_on_object_action_button_pressed"]
