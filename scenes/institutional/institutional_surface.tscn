[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/institutional/institutional_surface.gd" id="1_institutional"]
[ext_resource type="PackedScene" path="res://scenes/visual/institutional_diorama.tscn" id="2_interactive_3d"]

[node name="InstitutionalSurface" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_institutional")

[node name="Interactive3D" parent="." instance=ExtResource("2_interactive_3d")]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchor_top = 0.49
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_right = -8.0
offset_bottom = -8.0
grow_horizontal = 2
grow_vertical = 2

[node name="Scroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Content" type="VBoxContainer" parent="Margin/Scroll"]
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Scroll/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Institucional"

[node name="Boundary" type="Label" parent="Margin/Scroll/Content"]
layout_mode = 2
text = "Sistema ficcional do jogo. O sistema cívico e institucional é inteiramente fictício e não representa instituições, partidos, eleições, legislação ou orientação do mundo real."
autowrap_mode = 2

[node name="InstitutionLevelLabel" type="Label" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Instituição ficcional: nível 0 / 3"

[node name="InstitutionContextLabel" type="Label" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Influence • Compliance • Comunidade • Reputação"
autowrap_mode = 2

[node name="CivicEngagementLabel" type="Label" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Participação cívica ficcional"
autowrap_mode = 2

[node name="CivicEngagementButton" type="Button" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
text = "Realizar participação cívica"

[node name="PolicySeparator" type="HSeparator" parent="Margin/Scroll/Content"]
layout_mode = 2

[node name="PolicyTitle" type="Label" parent="Margin/Scroll/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Propostas institucionais"

[node name="PolicyBoundary" type="Label" parent="Margin/Scroll/Content"]
layout_mode = 2
text = "As propostas são apresentadas sem ranking, recomendação ou opção preferida."
autowrap_mode = 2

[node name="PolicySelect" type="OptionButton" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 54)
layout_mode = 2

[node name="PolicyStateLabel" type="Label" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Estado da proposta"
autowrap_mode = 2

[node name="PolicyRequirementLabel" type="Label" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Pré-requisitos do jogo"
autowrap_mode = 2

[node name="PolicyEffectLabel" type="Label" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Efeitos conhecidos"
autowrap_mode = 2

[node name="PolicyEnactButton" type="Button" parent="Margin/Scroll/Content"]
