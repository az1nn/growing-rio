[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/institutional/institutional_surface.gd" id="1_institutional"]

[node name="InstitutionalSurface" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_institutional")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = -8.0
grow_horizontal = 2
grow_vertical = 2

[node name="Scroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Content" type="VBoxContainer" parent="Margin/Scroll"]
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Scroll/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Compliance"

[node name="Boundary" type="Label" parent="Margin/Scroll/Content"]
layout_mode = 2
text = "Sistema ficcional do jogo. Não representa exigências legais, regulatórias ou orientação do mundo real."
autowrap_mode = 2

[node name="ComplianceCurrentLabel" type="Label" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Compliance ficcional: nível 0 / 3"

[node name="ComplianceNextLabel" type="Label" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Próxima etapa"

[node name="ComplianceRequirementLabel" type="Label" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Requisitos do jogo"
autowrap_mode = 2

[node name="ComplianceProgressButton" type="Button" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
text = "Avançar compliance"
disabled = true

[node name="Separator" type="HSeparator" parent="Margin/Scroll/Content"]
layout_mode = 2

[node name="FeedbackTitle" type="Label" parent="Margin/Scroll/Content"]
layout_mode = 2
text = "Feedback recente"

[node name="ComplianceFeedbackLabel" type="Label" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Nenhuma progressão registrada nesta sessão."
autowrap_mode = 2

[node name="FutureBoundary" type="Label" parent="Margin/Scroll/Content"]
layout_mode = 2
text = "Políticas e progressão institucional ampla permanecem reservadas ao RB-09."
autowrap_mode = 2

[connection signal="pressed" from="Margin/Scroll/Content/ComplianceProgressButton" to="." method="_on_progress_pressed"]
